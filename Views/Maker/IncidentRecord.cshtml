@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.Title = "Incident Record";
}

@section Styles {
    <link href="~/css/register.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/riskcontent.js"></script>
    <script src="~/js/incidentregistration.js"></script>

}

<div class="card border-0 shadow-sm p-4">

    <!-- ========== PAGE HEADER ========== -->
    <div class="page-header">
        <h2>
            <i class="bi bi-card-checklist" style="color: var(--primary);"></i>
            Incident Record
            <span class="badge">New</span>
        </h2>
        <p>
            Register and document identified incident for comprehensive assessment, monitoring, and mitigation planning.
        </p>
    </div>

    <form id="createIncidentForm">

        <div class="p-4">
            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <label for="IdentifiedRisk" class="form-label">
                        Business Area of Incident
                        <span class="text-danger">*</span>
                    </label>

                    <select id="IdentifiedRisk" name="IdentifiedRisk" class="form-select" required>
                        <option value="">Choose an identified risk...</option>
                    </select>

                    <div class="form-text">
                        Select the business area where the risk was identified.
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="IncidentName">
                        Incident Name
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text" class="form-control modern-input" id="IncidentName" name="IncidentName"
                           placeholder="Enter incident name" required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="IncidentOwner">
                        Incident Owner
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text" class="form-control modern-input" id="IncidentOwner" name="IncidentOwner"
                           placeholder="Enter incident owner" required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="EventOccurredDate">
                        Event Occurred Date
                        <span class="text-danger">*</span>
                    </label>

                    <input type="date" class="form-control modern-input" id="EventOccurredDate" name="EventOccurredDate"
                           required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="EventEndedDate">
                        Event Ended Date
                        <span class="text-danger">*</span>
                    </label>

                    <input type="date" class="form-control modern-input" id="EventEndedDate" name="EventEndedDate"
                           required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="Priority">
                        Priority
                        <span class="text-danger">*</span>
                    </label>
                    <select id="Priority" name="Priority" class="form-select" required>
                        <option value="">Choose priority...</option>
                        <option value="Open">Open</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>

                    <div class="form-text">
                        Select priority.
                    </div>

                </div>

                <div class="col-lg-4 col-md-6">
                    <label for="SourceOfIncident" class="form-label">
                        Source of Incident
                        <span class="text-danger">*</span>
                    </label>

                  
                    <input type="text" class="form-control modern-input" id="SourceOfIncident" name="SourceOfIncident"
                           placeholder="Enter Event Cause" required />

                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="EventType">
                        Event Type
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text" class="form-control modern-input" id="EventType" name="EventType"
                           placeholder="Enter event type" required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="BusinessLine">
                        Business Line
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text" class="form-control modern-input" id="BusinessLine" name="BusinessLine"
                           placeholder="Enter business line" required />
                </div>

                <div class="col-lg-4 col-md-6">
                    <label class="form-label required-field" for="BusinessActivity">
                        Business Activity
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text" class="form-control modern-input" id="BusinessActivity" name="BusinessActivity"
                           placeholder="Enter business activity" required />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold" for="EventDescription">
                        Event Description
                        <span class="text-danger">*</span>
                    </label>

                    <textarea class="form-control modern-input" rows="6" id="EventDescription" name="EventDescription"
                              placeholder="Describe the incident in detail..." required></textarea>
                </div>


                <!-- Impact Parameters -->
                <div class="mt-4">

                    <div class="section-header mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-bar-chart-line me-2"></i>
                            Impact Parameters
                        </h5>
                        <div class="text-muted small">
                            Record the financial and insurance impact of the incident.
                        </div>
                    </div>

                    <div class="row g-4">

                        <!-- Loss Type -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="LossType">
                                Loss Type
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text" class="form-control modern-input" id="LossType" name="LossType"
                                   placeholder="Enter loss type" required />
                        </div>

                        <!-- Loss Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="LossDate">
                                Loss Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date" class="form-control modern-input" id="LossDate" name="LossDate"
                                   required />
                        </div>

                        <!-- Insurance -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="Insurance">
                                Insurance
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text" class="form-control modern-input" id="Insurance" name="Insurance"
                                   placeholder="Enter insurance details" required />
                        </div>

                        <!-- Loss Amount -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="LossAmount">
                                Loss Amount
                                <span class="text-danger">*</span>
                            </label>

                            <input type="number" class="form-control modern-input" id="LossAmount" name="LossAmount"
                                   placeholder="Enter loss amount" min="0" step="0.01" required />
                        </div>

                        <!-- Recovery Amount -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="RecoveryAmount">
                                Recovery Amount
                                <span class="text-danger">*</span>
                            </label>

                            <input type="number" class="form-control modern-input" id="RecoveryAmount"
                                   name="RecoveryAmount" placeholder="Enter recovery amount" min="0" step="0.01"
                                   required />
                        </div>

                        <!-- Net Loss Amount -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="NetLossAmount">
                                Net Loss Amount
                            </label>

                            <input type="number" class="form-control modern-input" id="NetLossAmount"
                                   name="NetLossAmount" placeholder="Calculated automatically" step="0.01" readonly />
                        </div>

                    </div>
                </div>
                <!-- Mitigation -->
                <div class="mt-4">

                    <div class="section-header mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-shield-check me-2"></i>
                            Mitigation
                        </h5>
                        <div class="text-muted small">
                            Define the actions required to address and reduce the impact of the incident.
                        </div>
                    </div>

                    <div class="row g-4">

                        <!-- Mitigation Action -->
                        <div class="col-lg-4 col-md-6">
                            <label for="MitigationAction" class="form-label required-field">
                                Mitigation Action
                                <span class="text-danger">*</span>
                            </label>

                            <select id="MitigationAction" name="MitigationAction" class="form-select" required>
                                <option value="">Choose mitigation action...</option>
                                <option value="No Action">No Action</option>
                                <option value="Corrective">Corrective</option>
                                <option value="Preventive">Preventive</option>
                            </select>
                        </div>

                        <!-- Action Type -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="ActionType">
                                Action Type
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text" class="form-control modern-input" id="ActionType" name="ActionType"
                                   placeholder="Enter action type" required />
                        </div>

                        <!-- Responsible Person -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="ResponsiblePerson">
                                Responsible Person
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text" class="form-control modern-input" id="ResponsiblePerson"
                                   name="ResponsiblePerson" placeholder="Enter responsible person" required />
                        </div>

                       

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label required-field" for="MitigationDescription">
                                Description
                                <span class="text-danger">*</span>
                            </label>

                            <textarea class="form-control modern-input" rows="5" id="MitigationDescription"
                                      name="MitigationDescription" placeholder="Describe the mitigation action in detail..."
                                      required></textarea>
                        </div>


 <!-- Start Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="MitigationStartDate">
                                Start Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date" class="form-control modern-input" id="MitigationStartDate"
                                   name="MitigationStartDate" required />
                        </div>

                        <!-- End Date -->
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label required-field" for="MitigationEndDate">
                                End Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date" class="form-control modern-input" id="MitigationEndDate"
                                   name="MitigationEndDate" required />
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="Status">
                                <i class="fas fa-flag" style="color: var(--gray-400); margin-right: 4px;"></i>
                                Status
                                 <span class="text-danger">*</span>
                            </label>
                            <select class="form-select modern-input" id="Status" name="Status">
                                <option value="">Choose Status...</option>
                                <option value="Open">Open</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>

                    </div>
                </div>

                
            </div>
        </div>

        <div class="wizard-footer">

            <button type="reset" class="btn btn-outline-secondary" id="clearFormBtn">
                <i class="bi bi-arrow-counterclockwise me-2"></i>
                Clear Form
            </button>

            <button type="submit" class="btn btn-success" id="submitRiskBtn">
                <i class="bi bi-floppy me-2"></i>
                Record Incident
            </button>

        </div>

    </form>

</div>

<!-- Response Modal -->
<div class="modal fade" id="responseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 rounded-4 shadow-lg">
            <div id="modalIcon" class="mb-3" style="font-size: 60px;"></div>
            <h5 id="modalTitle" class="fw-bold"></h5>
            <p id="modalMessage" class="mt-2"></p>
            <button id="okButton" type="button"
                    class="btn btn-success mt-3 px-5 py-2 rounded-pill shadow-lg btn-animated" data-bs-dismiss="modal">
                OK
            </button>
        </div>
    </div>
</div>

