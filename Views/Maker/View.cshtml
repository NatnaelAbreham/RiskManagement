@{
    ViewBag.Title = @User.Identity.Name;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@section Styles {
    <link href="~/css/register.css" rel="stylesheet" />
    <link href="~/css/view.css" rel="stylesheet" />
    <link href="~/css/editmodal.css" rel="stylesheet" />
    <link href="~/css/table.css" rel="stylesheet" />
}
@section Scripts {
    <script src="~/js/riskcontent.js"></script>
    <script src="~/js/editrisk.js"></script>
}
@model List<RiskManagement.Models.RiskRegistration>


<div class="card shadow-lg p-4">
    <div class="card-header bg-transparent border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-shield-check text-success me-2"></i>
                Risk Records
            </h4>
        </div>
    </div>
    <div class="table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table table-hover table-bordered text-center align-middle" id="dataTable">
                <thead>
                    <tr>
                        <th>Risk ID</th>

                        <!-- Section 1: Risk Information -->
                        <th>Risk Date</th>
                        <th>Identified Risk</th>
                        <th>Risk Category</th>

                        <!-- Section 2: Risk Assessment -->
                      
                        <!-- Section 3: Mitigation & Controls -->
                        <th>Existing Risk Mitigation</th>
                        <th>Mitigation Rating</th>

                        <!-- Section 4: Ownership & Planning -->
                        <th>Risk Owner</th>

                        <!-- Optional -->
                        <th>Status</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {

                        foreach (var user in Model)
                        {
                            @if (user.Status == "rejected")
                            {
                                continue;
                            }
                            <tr>

                                <td>@user.RiskId</td>

                                <!-- Section 1: Risk Information -->
                                <td>@user.RiskDate.ToString("yyyy-MM-dd")</td>
                                <td>@user.IdentifiedRisk</td>
                                <td>@user.RiskCategory</td>

                                <!-- Section 3: Mitigation & Controls -->
                                <td>@user.ExistingRiskMitigation</td>
                                <td>@user.MitigationRating</td>

                                <!-- Section 4: Ownership & Planning -->
                                <td>@user.RiskOwner</td>
                                <td>
                                    @if (user.Status == "approved")
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            Approved
                                        </span>
                                    }
                                    else if (user.Status == "rejected")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        @* <i class="bi bi-dash text-muted"></i> *@
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>

                                    @if (user.Status == "rejected" || user.Status == "pending")
                                    {
                                        <button class="btn btn-outline-success edit-btn"
                                                data-user='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user))'>
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success edit-btn"
                                                data-user='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user))'>
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                    }

                                           
                                       
                                </td>
                            </tr>

                                
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted">No data available</td>
                        </tr>
                    }
                </tbody>
            </table>

        }
        else
        {

            <h6 colspan="6" class="text-muted">No data available!</h6>

        }
    </div>
</div>


<!-- Modal Body -->
<!-- Edit Risk Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-top-safe">

        <div class="modal-content risk-edit-modal">

            <!-- Header -->
            <div class="modal-header risk-edit-header">

                <div class="risk-edit-title">
                    <div class="risk-edit-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <div>
                        <h5 class="modal-title" id="editModalLabel">
                            Edit Risk Information
                        </h5>

                        <small>
                            Update the risk details and assessment
                        </small>
                    </div>
                </div>

                <button type="button" class="btn-close risk-edit-close" data-bs-dismiss="modal" aria-label="Close">
                </button>

            </div>

            <!-- Body -->
            <div class="modal-body risk-edit-body">
                <div class="row" id="editModalContent"></div>
            </div>

            <!-- Footer -->
            <div class="modal-footer risk-edit-footer" id="editModalFooter">
                <!-- Buttons added by JavaScript -->
            </div>

        </div>
    </div>
</div>
      