@model List<RiskManagement.Models.RiskRegistration>

@{
    ViewBag.Title = User.Identity?.Name ?? "Risk Approval";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link href="~/css/view.css" rel="stylesheet" />
    <link href="~/css/table.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/approverisk.js"></script>
}


<div class="card shadow-lg p-4">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="card-header bg-transparent border-0 py-3">

        <div class="d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0">

                <i class="bi bi-shield-check text-success me-2"></i>

                Risk Approval Records

            </h4>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- RISK TABLE -->
    <!-- ===================================================== -->

    <div class="table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table table-hover table-bordered text-center align-middle" id="dataTable">

                <thead class="table-secondary">

                    <tr>

                        <!-- Risk Information -->
                        <th>Risk ID</th>
                        <th>Risk Date</th>
                        <th>Business Unit</th>
                        <th>Risk Category</th>

                        <!-- Risk Assessment -->
                        @* <th>Probability</th>
                        <th>Impact Level</th> *@
                        <th>Inherent Risk Rating</th>
                        <th>Residual Risk Level</th>

                        @* <!-- Mitigation -->
                        <th>Mitigation Rating</th> *@

                        <!-- Ownership -->
                        <th>Risk Owner</th>

                        <!-- Status -->
                        <th>Status</th>

                        <!-- Action -->
                        <th>Review</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {
                        /*
                         * Rejected risks should not appear
                         * on the approval page.
                         */

                        @if (string.Equals(
                            user.Status,
                            "rejected",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }


                        <tr>

                            <!-- ================================================= -->
                            <!-- RISK INFORMATION -->
                            <!-- ================================================= -->

                            <td>
                                <span class="fw-semibold">
                                    @user.RiskId
                                </span>
                            </td>


                            <td>
                                @user.RiskDate.ToString("yyyy-MM-dd")
                            </td>


                            <td>
                                @user.IdentifiedRisk
                            </td>


                            <td>
                                @user.RiskCategory
                            </td>


                            <!-- ================================================= -->
                            <!-- RISK ASSESSMENT -->
                            <!-- ================================================= -->

                           @*  <td>
                                @user.Probability
                            </td>


                            <td>
                                @user.ImpactLevel
                            </td> *@


                            <td>
                                @user.InherentRiskRating
                            </td>


                            <td>
                                @user.ResidualRiskLevel
                            </td>


                            <!-- ================================================= -->
                            <!-- MITIGATION -->
                            <!-- ================================================= -->

                           @*  <td>
                                @user.MitigationRating
                            </td> *@


                            <!-- ================================================= -->
                            <!-- OWNERSHIP -->
                            <!-- ================================================= -->

                            <td>
                                @user.RiskOwner
                            </td>


                            <!-- ================================================= -->
                            <!-- STATUS -->
                            <!-- ================================================= -->

                            <td>

                                @if (string.Equals(
                                    user.Status,
                                    "approved",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        Approved
                                    </span>
                                }
                                else if (string.Equals(
                                    user.Status,
                                    "rejected",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                        Pending
                                    </span>
                                }

                            </td>


                            <!-- ================================================= -->
                            <!-- REVIEW BUTTON -->
                            <!-- ================================================= -->

                            <td>

                                <button type="button" class="btn btn-outline-success approveBtn" title="Review Risk" data-user='@Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(user)
                                        )'>

                                    <i class="bi bi-eye-fill"></i>

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <!-- ================================================= -->
            <!-- NO DATA -->
            <!-- ================================================= -->

            <div class="text-center py-5">

                <i class="bi bi-inbox fs-1 text-muted"></i>

                <h6 class="text-muted mt-3">
                    No risk records available for approval.
                </h6>

            </div>
        }

    </div>

</div>



<!-- ========================================================= -->
<!-- RISK REVIEW / APPROVAL MODAL -->
<!-- ========================================================= -->

<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-top-safe">

        <div class="modal-content">


            <!-- ================================================= -->
            <!-- MODAL HEADER -->
            <!-- ================================================= -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="editModalLabel">

                    <i class="bi bi-shield-check text-success me-2"></i>

                    Risk Information

                </h5>


                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>

            </div>


            <!-- ================================================= -->
            <!-- MODAL BODY -->
            <!-- ================================================= -->

            <div class="modal-body">

                <div class="row g-2" id="editModalContent">

                    <!--
                        Risk information is populated
                        dynamically by approverisk.js
                    -->

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MODAL FOOTER -->
            <!-- ================================================= -->

            <div class="modal-footer justify-content-center" id="editModalFooter">

                <!--
                    Approve and Reject buttons are populated
                    dynamically by approverisk.js
                -->

            </div>

        </div>

    </div>

</div>

